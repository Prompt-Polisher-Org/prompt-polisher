# The backend reads the repo-root .env file (see app/core/config.py).
#
# From the repo root:
#     cp .env.example .env
#
# You only need a backend/.env if you want to override the root values for a
# backend running outside Docker — it takes precedence when both exist.
# Copy the root .env.example as your starting point:
#     cp ../.env.example .env
