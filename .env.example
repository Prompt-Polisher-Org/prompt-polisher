# ============================================
# Prompt Polisher — Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#     cp .env.example .env
# NEVER commit .env to git!
#
# Every name below is read by backend/app/core/config.py (Settings) or
# directly via os.getenv(). If you add a variable here, wire it up there too.
# ============================================

# ---- Database (PostgreSQL) ----
# POSTGRES_SERVER / POSTGRES_PORT depend on where the backend runs:
#   • backend on the host  (uvicorn)       → localhost : 5433  (the port docker-compose publishes)
#   • backend in Docker    (compose)       → postgres  : 5432  (overridden by docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=prompt_db
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433

# ---- JWT Authentication ----
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Encryption at rest (user API keys) ----
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, a key is derived from SECRET_KEY — fine for a demo, not for production.
ENCRYPTION_KEY=

# ---- OAuth 2.0 ----
# Optional. Leave blank to demo with email/password login only.
# Callback URLs are <OAUTH_REDIRECT_BASE_URL>/api/v1/auth/oauth/{google,github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# ---- Redis (cache, rate limiting, Celery broker) ----
# REDIS_HOST/PORT/DB build settings.REDIS_URL, which Celery also uses.
# REDIS_URL is read directly by app/main.py for the rate limiter.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Qdrant (Vector Database for RAG) ----
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- AI Inference Server ----
# The FastAPI service in ai/src/inference/server.py.
# Runs in mock mode until a checkpoint exists at ai/models/checkpoints/final_model.pt
AI_INFERENCE_SERVER_URL=http://localhost:8001

# ---- Frontend ----
# Must include the /api/v1 suffix — frontend/src/lib/api.ts uses this as the axios baseURL.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Load testing (backend/tests/load/locustfile.py) ----
LOCUST_HOST=http://localhost:8000
